# 大肥鱼历险记 · 环境变量模板
# 用法：复制本文件为 .env，填入 Key；`npm start` 会自动读取（进程环境变量优先）。
# 不要把真实 Key 提交到仓库或打包进比赛压缩包。

# 必填：DeepSeek API Key（仅本地代理模式需要；不填则游戏自动使用离线本地评分）
DEEPSEEK_API_KEY=

# 可选：模型名，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# 可选：API 基地址，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：本地服务端口，默认 8123
PORT=8123
